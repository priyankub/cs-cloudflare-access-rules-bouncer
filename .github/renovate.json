{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "labels": [
    "dependencies",
    "no-stale"
  ],
  "commitMessagePrefix": "⬆️",
  "commitMessageTopic": "{{depName}}",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Python base image: stay on the 3.13 line; take a new minor deliberately.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "groupName": "All Homelab Dependencies",
      "groupSlug": "all-homelab-deps",
      "description": "Squash all incoming dependency updates into a single consolidated branch to eliminate separate commit noise.",
      "matchPackageNames": [
        "*"
      ]
    }
  ]
}
